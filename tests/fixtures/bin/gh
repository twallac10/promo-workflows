#!/usr/bin/env bash
# Test stub for gh: appends each call to $GH_LOG (one line), saves any stdin
# body to $GH_LOG.body.<n>, and answers just enough for the promote scripts.
n=$(( $(wc -l < "$GH_LOG" 2>/dev/null || echo 0) + 1 ))
echo "$*" >> "$GH_LOG"
case "$*" in
  *--input\ -*) cat > "$GH_LOG.body.$n";;
esac
case "$*" in
  "api repos/"*"/deployments?environment="*)
    all="$*"
    # Only the promote workflow's Deployments (task=promote) are evidence. Any other
    # query gets the environment's newest Deployment: a gate job's, still waiting.
    case "$all" in *task=promote*) ;; *) echo '[{"id": 1, "payload": {}}]'; exit 0;; esac
    e=${all#*environment=}; e=${e%%&*}; cat "${GH_FIXTURES:-/nonexistent}/deployments-$e.json" 2>/dev/null || echo '[]';;
  "api repos/"*"/deployments/1/statuses"*) echo '[{"state": "waiting"}]';;
  "api repos/"*"/deployments/"*"/statuses"*)
    all="$*"; i=${all#*deployments/}; i=${i%%/*}; cat "${GH_FIXTURES:-/nonexistent}/statuses-$i.json" 2>/dev/null || echo '[]';;
  "api -X POST repos/"*/deployments\ *) echo '{"id": 42}';;
  "api -X POST repos/"*/statuses\ *) echo '{}';;
  "pr list"*) [ -n "${GH_OPEN_PR:-}" ] && echo "$GH_OPEN_PR"; true;;
  "pr create"*) echo "https://github.com/twallac10/promo-kyverno-policies/pull/7";;
  "pr merge"*) [ "${GH_MERGE_FAIL:-}" = 1 ] && { echo "auto-merge is not allowed for this repository" >&2; exit 1; }; true;;
esac
exit 0
